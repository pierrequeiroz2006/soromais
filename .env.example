# ---- Backend (copy to .env — never commit the real file) ----
# Frontend origin(s) allowed by CORS, comma separated.
# Example: https://soromais.vercel.app,https://www.soromais.com
ALLOWED_ORIGINS=

# Auth: set at least one. If none are set the API is OPEN (dev only).
API_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256

# Supabase — MUST be the anon key, not the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini
GEMINI_API_KEY=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Image fetch hardening (SSRF) — comma separated host allowlist (supports *.domain)
ALLOWED_IMAGE_HOSTS=*.supabase.co,*.supabase.in
MAX_IMAGE_BYTES=5242880

# Upload hardening
MAX_UPLOAD_BYTES=10485760
MAX_USER_INPUT_LEN=300

# Logging
LOG_LEVEL=INFO

# ---- docker-compose (Evolution API / Postgres) ----
POSTGRES_DB=evolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
AUTHENTICATION_API_KEY=
